# 复制为 .env 后填入强随机值(openssl rand -hex 32)
# 注意:这三个值必须替换,使用默认占位值等于没有防护。
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME
CREDENTIALS_ENC_SECRET=CHANGE_ME

# 可选:锁定镜像版本(默认 latest)。预发布版本不建议用于生产。
# GATEWAY_VERSION=1.0.0

# 可选:限制管理台来源 / 调整入口限流
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_BURST=60
# EMIT_THINKING=auto
